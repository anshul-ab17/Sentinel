{
  "$id": "sentinel.event.v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "event_id", "cluster", "slot", "signature", "instruction_path", "kind", "commitment", "protocol", "decoder_version", "amount_raw", "decimals", "source_observation_ids", "coverage"],
  "properties": {
    "schema_version": { "type": "string", "const": "sentinel.event.v1" },
    "event_id": { "type": "string", "minLength": 1 },
    "cluster": { "type": "string", "minLength": 1 },
    "slot": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 20 },
    "signature": { "type": "string", "minLength": 1 },
    "instruction_path": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 } },
    "kind": { "type": "string", "minLength": 1 },
    "commitment": { "type": "string", "enum": ["processed", "confirmed", "finalized"] },
    "protocol": { "type": "string", "minLength": 1 },
    "decoder_version": { "type": "string", "minLength": 1 },
    "amount_raw": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 39 },
    "decimals": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 },
    "source_observation_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "coverage": { "type": "string", "enum": ["partial", "complete", "synthetic"] }
  }
}
